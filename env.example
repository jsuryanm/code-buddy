# Copy to .env and fill in. Never commit .env.
# (Named env.example because .claude/settings.json denies reads of .env.* files.)
OPENAI_API_KEY=

# OpenAI model IDs per tier. No defaults on purpose; pin current IDs yourself.
CODEBUDDY_MODEL_FAST=
CODEBUDDY_MODEL_STANDARD=
CODEBUDDY_MODEL_HEAVY=

# Upstash Redis (REST). Without these the API falls back to an in-process cache.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: Qdrant server instead of the embedded index in data/index
# CODEBUDDY_QDRANT_URL=http://localhost:6333

# Voice input (Groq Whisper). Optional OpenAI transcription fallback needs
# CODEBUDDY_STT_FALLBACK_MODEL plus OPENAI_API_KEY.
GROQ_API_KEY=
# CODEBUDDY_STT_FALLBACK_MODEL=

# API protection. Empty CODEBUDDY_API_KEYS leaves the API open (fine on localhost only).
# CODEBUDDY_API_KEYS=key-one,key-two
# CODEBUDDY_RATE_LIMIT_PER_MINUTE=30
# CODEBUDDY_CORS_ORIGINS=https://your-frontend.example

# Optional features, off by default
# CODEBUDDY_SEMANTIC_CACHE_THRESHOLD=0.95
# CODEBUDDY_JUDGE_SAMPLE_RATE=0.05
# CODEBUDDY_MCP_ENABLED=false

# Long-term learner memory (opt-in per learner in the UI). It calls OpenAI to extract notes
# and stores personal data on this server; learners can delete it with "Forget me".
# CODEBUDDY_MEMORY_ENABLED=true
# CODEBUDDY_MEMORY_PATH=data/memory
